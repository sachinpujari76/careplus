# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL Connection Details (Injected automatically in AIS runtime)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="hms_database"
SQL_USER="postgres_user"
SQL_PASSWORD="postgres_password"
SQL_ADMIN_USER="postgres_admin"
SQL_ADMIN_PASSWORD="postgres_admin_password"

# Authentication & Security
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_32_BYTES"

# Payment Gateway (UPI, Cards, Net Banking)
PAYMENT_KEY="rzp_test_YOUR_KEY_ID"
PAYMENT_SECRET="YOUR_PAYMENT_GATEWAY_SECRET"

# Communication & Notifications (Email/SMS)
EMAIL_API_KEY="SG.YOUR_SENDGRID_OR_RESEND_KEY"
SMS_API_KEY="YOUR_TWILIO_OR_FAST2SMS_KEY"

